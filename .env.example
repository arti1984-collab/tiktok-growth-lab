# --- KI-Anbieter (OpenAI-kompatibel) -------------------------------------
# Einen der kostenlosen Anbieter wählen – oder jede andere OpenAI-kompatible API.
#
# Google Gemini (Free-Tier, empfohlen, Key: https://aistudio.google.com/apikey)
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-3.8-flash
#
# Groq (Free-Plan, Key: https://console.groq.com/keys)
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-120b
#
# OpenRouter (Modelle mit :free sind kostenlos, Key: https://openrouter.ai/keys)
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=nvidia/nemotron-3.5-lightning:free
#
# Ollama (lokal, kein Key nötig)
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=qwen3:8b
#
# OpenAI/ChatGPT: kein kostenloses API-Kontingent, nur Pay-as-you-go.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# API-Key. Kann auch in der Bedienoberfläche unter "Einstellungen" hinterlegt werden.
AI_API_KEY=

# --- Scraper --------------------------------------------------------------
# Mindestabstand zwischen zwei TikTok-Anfragen in Millisekunden (höflich bleiben).
SCRAPE_MIN_DELAY_MS=1200
# Wie lange gescrapte Daten im Cache bleiben (Millisekunden).
SCRAPE_CACHE_TTL_MS=900000
# Optional: TikTok-Cookies aus dem Browser (nur nötig, wenn TikTok blockt).
# Format: "sessionid=...; tt_csrf_token=..."
TIKTOK_COOKIE=

# --- Server ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8787
